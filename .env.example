# Postgres used by the server and by `pnpm test:db` (local test DB started by scripts/test-db.sh)
DATABASE_URL=postgres://postgres@127.0.0.1:54329/armadillo_test

# Supabase (production Auth + Storage only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Claude (server-side only; never sent to the browser)
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
CLAUDE_MODEL=
KEY_ENCRYPTION_SECRET=

# Test-only auth provider (must never be set in production)
ARMADILLO_TEST_AUTH=
TEST_AUTH_SECRET=

# Local file store used in dev/test instead of Supabase Storage
LOCAL_FILE_STORE_DIR=.tmp/files
