# Postgres used by the server and by `pnpm test:db` (local test DB started by scripts/test-db.sh)
DATABASE_URL=postgres://postgres@127.0.0.1:54329/armadillo_test

# Supabase (production Auth + Storage only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Claude (server-side only; never sent to the browser)
# ANTHROPIC_API_KEY: workspace key, used when a user has not saved their own key in Settings.
# ANTHROPIC_BASE_URL: leave empty in production; tests point it at tests/support/anthropic-mock.ts.
# CLAUDE_MODEL: default model when the user's profile sets none (fallback: claude-sonnet-5-5).
# KEY_ENCRYPTION_SECRET: encrypts users' saved Claude keys (AES-256-GCM). 32 random bytes as hex or
#   base64 (`openssl rand -base64 32`), or any passphrase of at least 32 characters (HKDF-derived).
#   Required before anyone can save a key; changing it makes saved keys unreadable (users re-save).
# Optional tuning: CLAUDE_MAX_TOKENS (default 8192), CLAUDE_MAX_RETRIES (SDK retries, default 2).
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
CLAUDE_MODEL=
KEY_ENCRYPTION_SECRET=

# Test-only auth provider (must never be set in production). ARMADILLO_TEST_AUTH=1 enables the
# email-only HMAC-cookie sign-in; it refuses to run when NODE_ENV=production or VERCEL is set.
# TEST_AUTH_SECRET must be at least 32 characters.
ARMADILLO_TEST_AUTH=
TEST_AUTH_SECRET=

# Local file store used in dev/test instead of Supabase Storage
LOCAL_FILE_STORE_DIR=.tmp/files
