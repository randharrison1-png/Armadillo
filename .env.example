# Armadillo environment. Copy to .env.local for local development. Every variable is described in
# docs/deploy.md ("Environment variables"), including which are required in production.

# --- Database --------------------------------------------------------------------------------------
# Postgres used by the server and by `pnpm test:db` (local test DB started by scripts/test-db.sh).
# Production: the Supabase transaction pooler URL (port 6543).
DATABASE_URL=postgres://postgres@127.0.0.1:54329/armadillo_test
# Optional: connections per server instance (default 5).
# DATABASE_POOL_MAX=

# --- Site ------------------------------------------------------------------------------------------
# Absolute origin used in sitemap.xml / robots.txt (default http://localhost:3000). Set in production.
SITE_URL=
# Self-service sign-up (default true). "false" closes sign-up: the action refuses and the login page
# hides "Create an account" (accounts are then created in the Supabase dashboard).
SIGNUPS_ENABLED=

# --- Supabase (production Auth + Storage) -----------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Claude (server-side only; never sent to the browser) ------------------------------------------
# ANTHROPIC_API_KEY: workspace key, used when a user has not saved their own key in Settings.
# ANTHROPIC_BASE_URL: leave empty in production; tests point it at tests/support/anthropic-mock.ts.
# CLAUDE_MODEL: default model when the user's profile sets none (fallback: claude-sonnet-5-5).
# KEY_ENCRYPTION_SECRET: encrypts users' saved Claude keys (AES-256-GCM). 32 random bytes as hex or
#   base64 (`openssl rand -base64 32`), or any passphrase of at least 32 characters (HKDF-derived).
#   Required before anyone can save a key or send a pastebin abuse report (the reporter hash key is
#   derived from it); changing it makes saved keys unreadable (users re-save).
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
CLAUDE_MODEL=
KEY_ENCRYPTION_SECRET=
# Optional tuning (defaults in brackets):
#   CLAUDE_MAX_TOKENS       chat reply output tokens [8192]
#   CLAUDE_TOOL_MAX_TOKENS  structured call output tokens [16000]; also sets the largest script an
#                           adaptation accepts (about 41 KB at 16000)
#   CLAUDE_CONTEXT_TOKENS   document budget per request, 4 characters per token [60000]
#   CLAUDE_MAX_RETRIES      SDK retries on transient API errors [2]
# CLAUDE_MAX_TOKENS=
# CLAUDE_TOOL_MAX_TOKENS=
# CLAUDE_CONTEXT_TOKENS=
# CLAUDE_MAX_RETRIES=

# --- Local development and tests only (never set on a deployment) ---------------------------------
# Test-only auth provider. ARMADILLO_TEST_AUTH=1 enables the email-only HMAC-cookie sign-in; it
# refuses to run when NODE_ENV=production, VERCEL is set, or SUPABASE_SERVICE_ROLE_KEY /
# NEXT_PUBLIC_SUPABASE_URL is set. TEST_AUTH_SECRET must be at least 32 characters.
ARMADILLO_TEST_AUTH=
TEST_AUTH_SECRET=
# Local disk file store instead of Supabase Storage (e.g. .tmp/files). Leave blank in production:
# it is refused on Vercel. The e2e config sets it itself.
LOCAL_FILE_STORE_DIR=
# HMAC key (>= 32 characters) for the local store's signed download links; falls back to
# TEST_AUTH_SECRET.
LOCAL_FILE_SIGNING_SECRET=
